</div>

<script>
  // DYNAMIC PRESETS DATA STORE
  const SPECIALTY_PRESETS = {
    renewal: {
      subject: "Annual Service & Documentation Renewal Notice ($50 Promo)",
      recipient: "Client / Patient Records (Fax: 929-668-3330)",
      signoff: "renewal",
      body: "Your annual documentation and service agreement is set to expire in 30 days. To prevent any service interruption, please complete our brief asynchronous renewal questionnaire. Complete your annual renewal today at a special promotional rate of $50.00."
    },
    consent: {
      subject: "Patient/Client Informed Consent & Financial Disclosure",
      recipient: "Client Operations & Records (Fax: 929-668-3330)",
      signoff: "clinical",
      body: "I hereby acknowledge receipt of and provide informed consent for services provided. I acknowledge full financial disclosure of fee structures, including the annual administrative renewal fee of $50.00 due upon 11-month review."
    },
    terms: {
      subject: "Master Service Terms & Conditions Agreement",
      recipient: "All Active Client & Subscriber Accounts",
      signoff: "legal",
      body: "This Master Service Terms & Conditions Agreement governs the relationship between provider and client. Service authorizations remain valid for a period of 12 months from execution and are subject to annual asynchronous renewal."
    },
    rental: {
      subject: "Commercial / Residential Rental Agreement & Lease Extension",
      recipient: "Tenant Records & Property Management Desk (Fax: 929-668-3330)",
      signoff: "rental",
      body: "This agreement confirms lease parameters and terms for the subject premises. Landlord and Tenant agree to a 12-month term with an 11-month asynchronous renewal notice window, offering early extension options at promotional processing rates."
    },
    privacy: {
      subject: "Privacy Policy & Data Protection / HIPAA Disclosure",
      recipient: "Compliance Officer & Data Protection Desk",
      signoff: "legal",
      body: "We are committed to maintaining strict privacy, confidentiality, and data security standards under HIPAA and applicable privacy laws. Protected health information (PHI) and client records are stored securely and encrypted."
    },
    education: {
      subject: "Annual Educational Accommodation Request (504 Plan)",
      recipient: "Dept of Education - Accommodations Division (Fax: 929-668-3330)",
      signoff: "ed",
      body: "This letter serves as formal clinical documentation supporting educational accommodations under Section 504 for the student. Based on annual evaluation, it is recommended that extra testing time, quiet environment seating, and assistive technology access be provided for the 2026-2027 academic year."
    },
    legal: {
      subject: "Annual Legal Compliance Statement & Retainer Renewal",
      recipient: "Corporate Compliance Division - Client Records (Fax: 929-668-3330)",
      signoff: "legal",
      body: "Please accept this annual legal compliance review statement as required under client representation guidelines. All corporate disclosures and annual regulatory filings have been verified for the upcoming 12-month period."
    }
  };

  const SIGNOFF_BLOCKS = {
    renewal: "<strong>Sharon DeJesus, NP, PMHNP</strong><br>Works Connect™ Client Services & Renewal Engine<br>License #123456 | NPI #9988776655",
    legal: "<strong>Office of Legal Counsel</strong><br>Works Connect™ Legal Compliance Division<br>Bar Roll #887722 | Fax Desk: 929-668-3330",
    rental: "<strong>Property Management Desk</strong><br>Leasing & Compliance Division<br>Fax Desk: 929-668-3330",
    clinical: "<strong>Sharon DeJesus, NP, PMHNP</strong><br>Private Practice Center of NY | Compliance Office<br>Lic #123456 | NPI #9988776655",
    ed: "<strong>Sharon DeJesus, NP, PMHNP</strong><br>Educational & Clinical Advocacy Services<br>License #123456 | NPI #9988776655"
  };

  // REAL-TIME SYNCHRONIZATION
  function syncPreview() {
    const subject = document.getElementById('input-subject').value;
    const recipient = document.getElementById('input-recipient').value;
    const body = document.getElementById('input-body').value;

    document.getElementById('prev-subject').innerText = subject || 'Untitled Document';
    document.getElementById('prev-recipient').innerText = 'To: ' + (recipient || 'Unspecified Recipient');
    document.getElementById('prev-body').innerText = body;
  }

  function updateSignoff(key) {
    document.getElementById('prev-signoff-block').innerHTML = SIGNOFF_BLOCKS[key] || SIGNOFF_BLOCKS['renewal'];
  }

  function loadSpecialtyPreset(key) {
    const preset = SPECIALTY_PRESETS[key];
    if (!preset) return;

    document.getElementById('input-subject').value = preset.subject;
    document.getElementById('input-recipient').value = preset.recipient;
    document.getElementById('input-body').value = preset.body;
    document.getElementById('select-signoff').value = preset.signoff;
    
    updateSignoff(preset.signoff);
    syncPreview();
    showToast("Loaded " + key.toUpperCase() + " Template Framework");
  }

  // VIEW SWITCHER
  function switchMode(mode) {
    const editor = document.getElementById('mode-editor');
    const preview = document.getElementById('mode-preview');
    const queue = document.getElementById('mode-queue');

    const tabEditor = document.getElementById('tab-editor');
    const tabPreview = document.getElementById('tab-preview');
    const tabQueue = document.getElementById('tab-queue');

    editor.style.display = 'none';
    preview.style.display = 'none';
    queue.style.display = 'none';

    tabEditor.classList.remove('active');
    tabPreview.classList.remove('active');
    tabQueue.classList.remove('active');

    if (mode === 'editor') {
      editor.style.display = 'flex';
      tabEditor.classList.add('active');
    } else if (mode === 'preview') {
      syncPreview();
      preview.style.display = 'block';
      tabPreview.classList.add('active');
    } else if (mode === 'queue') {
      queue.style.display = 'block';
      tabQueue.classList.add('active');
    }
  }

  // AI ASSISTANT MODAL
  function toggleAI(show) {
    const popover = document.getElementById('ai-popover');
    if (show) popover.classList.add('visible');
    else popover.classList.remove('visible');
  }

  function runAIEnhance(type) {
    const bodyElem = document.getElementById('input-body');
    if (type === 'formal') {
      bodyElem.value = "PURSUANT TO LEGAL & COMPLIANCE REVIEW: " + bodyElem.value + " This agreement is executed under binding statutory provisions and valid through the stated expiration date.";
    } else {
      bodyElem.value = "Summary Notice: " + bodyElem.value;
    }
    toggleAI(false);
    syncPreview();
    showToast("AI Assistant Refined Agreement Text");
  }

  function formatText(style) {
    showToast("Formatted selection: " + style.toUpperCase());
  }

  // ASYNCHRONOUS RENEWAL & LAYER 1 API SIMULATION
  function triggerAsynchronousForm(client, price) {
    showToast("SMS/Email Async Form sent to " + client + " (" + price + " Promo)");
  }

  function autoReissueLetter(client) {
    document.getElementById('input-subject').value = "RENEWAL: Informed Consent & Service Terms";
    document.getElementById('input-recipient').value = client + " (Annual Compliance Record)";
    switchMode('editor');
    showToast("Re-issuing agreement for " + client);
  }

  function dispatchFaxToSelf() {
    showToast("Fax dispatched to self: 929-668-3330 (JSON status: QUEUED)");
  }

  function dispatchSendAndInvoice() {
    showToast("Agreement sent & $50 Invoice Link created via Telnyx API");
  }

  function showToast(msg) {
    const toast = document.getElementById('toast');
    document.getElementById('toast-message').innerText = msg;
    toast.classList.add('show');
    setTimeout(() => {
      hideToast();
    }, 3500);
  }

  function hideToast() {
    document.getElementById('toast').classList.remove('show');
  }

  // INITIALIZE ON LOAD
  window.onload = function() {
    syncPreview();
    updateSignoff('renewal');
  };
</script>
</body>
